# --- LLM: any OpenAI-compatible endpoint (open models) -------------------
# Groq:        LLM_BASE_URL=https://api.groq.com/openai/v1
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1
# Together:    LLM_BASE_URL=https://api.together.xyz/v1
# Ollama:      LLM_BASE_URL=http://localhost:11434/v1   (LLM_API_KEY=ollama)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# A model id from your provider that supports tool calling
LLM_MODEL=openai/gpt-oss-120b
# For reasoning models like gpt-oss: low / medium / high
LLM_REASONING_EFFORT=medium
LLM_WORKER_REASONING_EFFORT=low
# Optional: a faster/cheaper model for the worker agents
# LLM_WORKER_MODEL=
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=4096

# --- Or Claude instead (what the demo uses) ------------------------------
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# RAVENHOLD_MODEL=claude-sonnet-5-5
# RAVENHOLD_WORKER_MODEL=claude-haiku-5-5
# RAVENHOLD_COMMANDER_EFFORT=low
# RAVENHOLD_WORKER_EFFORT=low

# --- FalkorDB ------------------------------------------------------------
FALKORDB_HOST=localhost
# 6380 locally to avoid clashing with a local Redis
FALKORDB_PORT=6380
# FalkorDB Cloud instead: set host/port above and these (or FALKORDB_URL)
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=
# FALKORDB_SSL=false
# FALKORDB_URL=redis://default:<password>@<host>:<port>
# Hard stop for spend (keep below your credit balance)
# RAVENHOLD_BUDGET_USD=4.00
